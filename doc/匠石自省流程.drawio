<mxfile host="app.diagrams.net" type="device" pages="5">
<diagram id="overview" name="全流程">
<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="775" background="#ffffff" arrows="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-title" value="一次自省怎样走到结果" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#183947;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="18" width="965" height="40" as="geometry"/></mxCell><mxCell id="page-intro" value="两条路径可以提出新认识。一般自省还可以直接留下工具或交流建议。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#344957;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="62" width="948" height="27" as="geometry"/></mxCell><mxCell id="page-foot" value="图 2 展开触发来源　·　图 3 展开执行预算　·　图 4 展开评价　·　图 5 展开写入与读取" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#516775;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="742" width="952" height="24" as="geometry"/></mxCell><mxCell id="a" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;从已经发生的事开始&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;工具结果、认识被修正、闲时回顾，或人工指定主题&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="111" width="430" height="76" as="geometry"/></mxCell><mxCell id="b" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;从一次真实的回忆开始&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;记录当时找到了什么、主认知看到了什么、后来怎样回应&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="525" y="111" width="430" height="76" as="geometry"/></mxCell><mxCell id="c" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;一般自省｜回看选择与后果&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;自动任务等待后台机会。人工 reflect 可同步运行。&lt;br&gt;低档留下规则摘要，中高档可由模型回答六问。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="236" width="430" height="83" as="geometry"/></mxCell><mxCell id="d" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;回忆评价｜有线索才再加工&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;先判断召回是否有帮助。有具体理由和材料时，&lt;br&gt;再检查旧经历之间的关系、冲突或修正。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="525" y="236" width="430" height="83" as="geometry"/></mxCell><mxCell id="e" value="&lt;font style=&quot;font-size:18px;color:#784A31&quot;&gt;&lt;b&gt;工具需求、后续交流&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;可以独立提出，或与新认识并存。&lt;br&gt;记录为建议，等待后续处理。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FBEDE4;strokeColor=#D1A688;fontColor=#784A31;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="375" width="252" height="85" as="geometry"/></mxCell><mxCell id="f" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;候选结果值得留下吗？&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;对照来源、增量和用途，逐项比较并说明理由。&lt;br&gt;两条路径都允许没有学习候选，活动到此结束。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="365" y="375" width="380" height="85" as="geometry"/></mxCell><mxCell id="g" value="&lt;font style=&quot;font-size:18px;color:#4B505B&quot;&gt;&lt;b&gt;放弃&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#304755&quot;&gt;移出试验区，活动历史仍可追查。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F2F3F5;strokeColor=#A7ABB4;fontColor=#4B505B;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="526" width="270" height="79" as="geometry"/></mxCell><mxCell id="h" value="&lt;font style=&quot;font-size:18px;color:#594477&quot;&gt;&lt;b&gt;待观察&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#304755&quot;&gt;留在 A/B 试验区，等待下次比较。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F2EDFA;strokeColor=#B8A3D1;fontColor=#594477;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="365" y="526" width="270" height="79" as="geometry"/></mxCell><mxCell id="i" value="&lt;font style=&quot;font-size:18px;color:#285945&quot;&gt;&lt;b&gt;采纳｜可多选&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;校验人物归属，按实际容量交付。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#E7F4EE;strokeColor=#76AD96;fontColor=#285945;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="695" y="526" width="260" height="79" as="geometry"/></mxCell><mxCell id="j" value="&lt;font style=&quot;font-size:18px;color:#285945&quot;&gt;&lt;b&gt;记忆　·　个人经验　·　人物相处经验&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;后续由不同入口读取，正文只存一份。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#E7F4EE;strokeColor=#76AD96;fontColor=#285945;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="595" y="654" width="360" height="75" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.27;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.77;exitY=1;entryX=0.17;entryY=0;" edge="1" parent="1" source="c" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.48;exitY=1;entryX=0.83;entryY=0;" edge="1" parent="1" source="d" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.13;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f" target="h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.86;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f" target="i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="i" target="j"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="triggers" name="触发来源">
<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="837" background="#ffffff" arrows="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-title" value="什么事情会让匠石回头想" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#183947;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="18" width="965" height="40" as="geometry"/></mxCell><mxCell id="page-intro" value="自动入口登记待办，人工可直接指定主题。图中的扫描条数、经历段数与等待时间均为可调默认值。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#344957;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="62" width="948" height="27" as="geometry"/></mxCell><mxCell id="page-foot" value="入口代码　reflection/sources/、reflection/queue.py、reflection/inprocess.py、reflection/memory_store.py" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#516775;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="804" width="952" height="24" as="geometry"/></mxCell><mxCell id="a" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;活动收尾｜工具已回报异常&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#304755&quot;&gt;执行器报非 ok，或明确说明未达预期。&lt;br&gt;仅检查收尾时已到的本活动结果。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="26" y="128" width="278" height="84" as="geometry"/></mxCell><mxCell id="b" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;人工修正或驳回已有认识&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;人工改状态并写理由。收尾或闲时&lt;br&gt;扫描主体历史，默认最近 50 条。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="26" y="257" width="278" height="86" as="geometry"/></mxCell><mxCell id="c" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;闲时回看旧经历&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;默认从最近 40 段中选最早一段，&lt;br&gt;查最近 200 条历史排除已选经历。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="26" y="390" width="278" height="88" as="geometry"/></mxCell><mxCell id="q" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;一般自省队列准入&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#304755&quot;&gt;同主题信号合并，队中重复请求去重。&lt;br&gt;默认冷却 1 小时，队列上限 8 条。&lt;br&gt;按当前代码，满队时新请求要比&lt;br&gt;队内最急的一条更急才可进入。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="353" y="243" width="278" height="115" as="geometry"/></mxCell><mxCell id="s" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;等待执行机会&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;自动后台择机取一条，急件优先。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="353" y="419" width="278" height="72" as="geometry"/></mxCell><mxCell id="m" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;人工指定｜reflect&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;高档、紧急，直接调用一般自省。&lt;br&gt;跳过后台轮询和普通入队限流。&lt;br&gt;仍可能因对话占用而让路。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="26" y="551" width="278" height="99" as="geometry"/></mxCell><mxCell id="x" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;还原现场 → 回看行为&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;现场不足时普通任务可结束。&lt;br&gt;人工或紧急任务可以注明材料不足。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="353" y="551" width="278" height="97" as="geometry"/></mxCell><mxCell id="r" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;主认知实际发起回忆&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;记录候选、可见条目和活动关联。&lt;br&gt;等待本轮结果。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="695" y="128" width="277" height="84" as="geometry"/></mxCell><mxCell id="w" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;形成一条回忆观察&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;接上计划、反馈及交付状态。等待&lt;br&gt;超时默认 5 分钟可再进入评价。&lt;br&gt;关闭、空查询、影子模式跳过评价。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="695" y="271" width="277" height="102" as="geometry"/></mxCell><mxCell id="v" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;进入回忆评价待办&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;正常回填时，待评阶段默认上限&lt;br&gt;100 条／主体。满时记下跳过原因。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="695" y="439" width="277" height="99" as="geometry"/></mxCell><mxCell id="z" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;待后台选中 → 回忆评价&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;具体判据见图 4。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="695" y="582" width="277" height="69" as="geometry"/></mxCell><mxCell id="note" value="&lt;font style=&quot;font-size:18px;color:#344957&quot;&gt;&lt;b&gt;当前闲时选材有固定顺序&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;情绪驱动、随机抽取一周前的经历、由任意主认知主动标记疑问，仍属于讨论方向。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F7F8FA;strokeColor=#C2CBD1;fontColor=#344957;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="26" y="709" width="946" height="70" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=1;exitY=0.55;entryX=0.18;entryY=0;" edge="1" parent="1" source="a" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=1;exitY=0.5;entryX=0;entryY=0.84;" edge="1" parent="1" source="c" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.65;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="q" target="s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="x"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m" target="x"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r" target="w"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="w" target="v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v" target="z"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="budget" name="调度与预算">
<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="884" background="#ffffff" arrows="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-title" value="后台什么时候获准执行" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#183947;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="18" width="965" height="40" as="geometry"/></mxCell><mxCell id="page-intro" value="以下为文字／语音会话后台的默认值。轮询只是检查机会，人工 reflect 和显式 drain 有各自入口。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#344957;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="62" width="948" height="27" as="geometry"/></mxCell><mxCell id="page-foot" value="例如上次运行 20:00，最后输入 20:09:50。普通新任务最早约 20:10:20 开始，仍需等空闲轮询。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#516775;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="851" width="952" height="24" as="geometry"/></mxCell><mxCell id="p" value="&lt;font style=&quot;font-size:18px;color:#244A70&quot;&gt;&lt;b&gt;会话后台每 2 秒检查一次&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;文字会话或语音宿主启动后登记。按主体检查。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF3FC;strokeColor=#97B3D4;fontColor=#244A70;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="526" height="66" as="geometry"/></mxCell><mxCell id="g" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;自省已启用，且前台空闲？&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;主对话、待处理输入、语音播放等占用时，本轮让路。&lt;br&gt;距最近输入还需满 30 秒，失败退避也需结束。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="224" width="526" height="87" as="geometry"/></mxCell><mxCell id="t" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;新任务距上次启动已满 600 秒？&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;一般新任务等 10 分钟。正在处理的回忆观察到了再加工或&lt;br&gt;比较阶段，可在后续空闲检查继续。间隔按主体上次运行计算。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="526" height="88" as="geometry"/></mxCell><mxCell id="l" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;取得执行锁，每次只做一个阶段&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;优先持久思考任务，再处理回忆观察，再看标准是否到期。&lt;br&gt;其余机会才取一般自省（含闲时选材）。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="478" width="526" height="78" as="geometry"/></mxCell><mxCell id="o" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;执行前和模型返回后再查前台&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;新输入到来则停止提交，保留待办。已发出的同步模型请求&lt;br&gt;仍可能消耗资源。阶段失败默认退避 600 秒再试。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="596" width="526" height="93" as="geometry"/></mxCell><mxCell id="ww" value="&lt;font style=&quot;font-size:18px;color:#594477&quot;&gt;&lt;b&gt;条件未满足或锁被占用&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;这次检查结束。只要会话仍在运行，&lt;br&gt;后续轮询会再次判断。&lt;br&gt;排进队列不保证立即执行。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F2EDFA;strokeColor=#B8A3D1;fontColor=#594477;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="626" y="235" width="336" height="119" as="geometry"/></mxCell><mxCell id="q" value="&lt;font style=&quot;font-size:18px;color:#344957&quot;&gt;&lt;b&gt;队列容量控制积压&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;一般自省队列上限 8。持久思考队列&lt;br&gt;默认也是 8 条／主体，按主题去重。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F7F8FA;strokeColor=#C2CBD1;fontColor=#344957;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="626" y="399" width="336" height="91" as="geometry"/></mxCell><mxCell id="mod" value="&lt;font style=&quot;font-size:18px;color:#344957&quot;&gt;&lt;b&gt;模型档位控制单次行为回顾&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;低档规则处理，模型调用 0 次。&lt;br&gt;有模型时中档、高档当前各调用一次。&lt;br&gt;高档 3 次、90 秒超时只登记为参数。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F7F8FA;strokeColor=#C2CBD1;fontColor=#344957;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="626" y="527" width="336" height="120" as="geometry"/></mxCell><mxCell id="b" value="&lt;font style=&quot;font-size:18px;color:#344957&quot;&gt;&lt;b&gt;这里控制的是机会、并发与每阶段材料&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;自动后台没有统一的每日 token 或金额硬上限。10 MiB 管的是试验样本占用，不能限制模型账单。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F7F8FA;strokeColor=#C2CBD1;fontColor=#344957;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="744" width="932" height="85" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g" target="t"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t" target="l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l" target="o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="未满足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=1;exitY=0.45;entryX=0;entryY=0.28;" edge="1" parent="1" source="g" target="ww"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="仍需等待" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=1;exitY=0.4;entryX=0.52;entryY=1;" edge="1" parent="1" source="t" target="ww"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="evaluation" name="评价与筛选">
<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="912" background="#ffffff" arrows="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-title" value="怎样从经历形成一个值得评价的候选" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#183947;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="18" width="965" height="40" as="geometry"/></mxCell><mxCell id="page-intro" value="先评价当时发生了什么，再评价这次新认识的价值。P 编号对应项目提示词索引。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#344957;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="62" width="948" height="27" as="geometry"/></mxCell><mxCell id="page-foot" value="结果进入图 5。工具和后续交流建议取自六问，可独立于学习候选成立。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#516775;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="879" width="952" height="24" as="geometry"/></mxCell><mxCell id="a" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;一般自省｜重建当时现场&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;以条目时间为中心，前后各 10 分钟。最多 40 段现场，&lt;br&gt;另取最多 6 条相关回忆。区分现场、回忆和人物归属。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="28" y="118" width="450" height="96" as="geometry"/></mxCell><mxCell id="b" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;回忆评价｜P80-30&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;对照原问题、候选、主认知实际可见与使用声明、交付状态，&lt;br&gt;以及相关的后续交流（默认 5 分钟窗口）。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="522" y="118" width="450" height="96" as="geometry"/></mxCell><mxCell id="c" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;六问回顾｜P80-10&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;发生了什么 → 我的选择与后果 → 为什么 → 能否做得更好&lt;br&gt;→ 下次怎么办、是否需工具或交流 → 哪些认识值得再评价。&lt;br&gt;低档仅规则摘录。无学习候选时可在活动记录处结束。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="28" y="264" width="450" height="101" as="geometry"/></mxCell><mxCell id="d" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;回忆质量反馈 → 是否需要再加工？&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;回写对检索有用的反馈。新观察须同时有再加工意向、&lt;br&gt;具体理由和事件材料。缺一项就结束。旧记录走兼容路径。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="522" y="264" width="450" height="101" as="geometry"/></mxCell><mxCell id="e" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;抽取一般自省候选&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;保留具体内容、归因和来源。逐条引用现场或回忆。&lt;br&gt;缺少逐条引用时只指向本次自省，不能据此认定人物。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="28" y="420" width="450" height="92" as="geometry"/></mxCell><mxCell id="f" value="&lt;font style=&quot;font-size:18px;color:#244B59&quot;&gt;&lt;b&gt;旧经历再加工｜P80-40&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;比较旧经历之间的关系、冲突或修正。可返回零条。&lt;br&gt;既有自省认识不能递归充当新认识的种子。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#EDF4F6;strokeColor=#91ADB8;fontColor=#244B59;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="522" y="420" width="450" height="92" as="geometry"/></mxCell><mxCell id="v" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;核对具体内容、依据、可追溯来源&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;逐字复述、空内容、缺依据或引用越界的材料被过滤。候选正文每条最多 2,000 字符。&lt;br&gt;初评材料先留在待办，走到这里仍未成为可召回记忆。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="139" y="565" width="722" height="91" as="geometry"/></mxCell><mxCell id="p" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;同一可替换评价模块｜P80-50&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#304755&quot;&gt;每次最多比较 24 条，总材料最多 24,000 字符。新候选最多占 12 条，兼取两桶首尾和轮换样本。&lt;br&gt;模型核对认识增量、证据范围和适用出口，给出相对次序与逐条去留理由。&lt;br&gt;模型输出无效或与可见材料不符时保留待办重试。程序再校验人物范围与容量。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="139" y="705" width="722" height="110" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.19;entryY=0;" edge="1" parent="1" source="e" target="v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.81;entryY=0;" edge="1" parent="1" source="f" target="v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v" target="p"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="outlets" name="结果与去向">
<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="916" background="#ffffff" arrows="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page-title" value="最后留下什么，谁能读到" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#183947;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="18" width="965" height="40" as="geometry"/></mxCell><mxCell id="page-intro" value="评价同时决定去留与用途。相对排序、模型建议的出口、程序实际交付的出口分别留痕。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#344957;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="62" width="948" height="27" as="geometry"/></mxCell><mxCell id="page-foot" value="10 MiB 和 20 MiB 均为正文预算。活动日志、待评材料、数据库页与索引另计。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#516775;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26" y="883" width="952" height="24" as="geometry"/></mxCell><mxCell id="r" value="&lt;font style=&quot;font-size:18px;color:#634616&quot;&gt;&lt;b&gt;评价模块给出逐项决定&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;新候选或抽样旧例，都可以放弃、留待观察或采纳。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FFF4D9;strokeColor=#D8A946;fontColor=#634616;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="260" y="108" width="480" height="68" as="geometry"/></mxCell><mxCell id="d" value="&lt;font style=&quot;font-size:18px;color:#4B505B&quot;&gt;&lt;b&gt;放弃&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;清出试验样本。活动历史仍可追查。&lt;br&gt;此前已沉淀的正式结果保留。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F2F3F5;strokeColor=#A7ABB4;fontColor=#4B505B;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="25" y="226" width="292" height="93" as="geometry"/></mxCell><mxCell id="s" value="&lt;font style=&quot;font-size:18px;color:#594477&quot;&gt;&lt;b&gt;待观察｜A/B 试验区&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#304755&quot;&gt;样本存入 pressure 表，每主体 10 MiB。&lt;br&gt;A、B 各 5 MiB，随比较滚动。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F2EDFA;strokeColor=#B8A3D1;fontColor=#594477;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="355" y="226" width="292" height="93" as="geometry"/></mxCell><mxCell id="k" value="&lt;font style=&quot;font-size:18px;color:#285945&quot;&gt;&lt;b&gt;采纳｜可同时选择多个出口&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;校验本轮可见 ID、逐条理由、去留&lt;br&gt;互斥、人物归属以及各出口容量。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#E7F4EE;strokeColor=#76AD96;fontColor=#285945;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="683" y="226" width="292" height="93" as="geometry"/></mxCell><mxCell id="u" value="&lt;font style=&quot;font-size:18px;color:#594477&quot;&gt;&lt;b&gt;试验样本怎样产生标准&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#304755&quot;&gt;至少 4 条有效样本可形成首版。此后任一桶相对&lt;br&gt;上版新增且仍存续的内容，占当前桶字节的&lt;br&gt;1/3 时可更新。各版标准存入 standards 表。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#F2EDFA;strokeColor=#B8A3D1;fontColor=#594477;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="25" y="379" width="393" height="116" as="geometry"/></mxCell><mxCell id="formal" value="&lt;font style=&quot;font-size:18px;color:#285945&quot;&gt;&lt;b&gt;写入正式结果｜同一条正文只存一份&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;按主体保存在 reflection_memory.sqlite3 的 insights 表，&lt;br&gt;记录可用出口与来源。正式结果正文共用默认 20 MiB。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#E7F4EE;strokeColor=#76AD96;fontColor=#285945;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="475" y="381" width="500" height="105" as="geometry"/></mxCell><mxCell id="m" value="&lt;font style=&quot;font-size:18px;color:#285945&quot;&gt;&lt;b&gt;可召回记忆&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;从普通回忆入口按查询取用。&lt;br&gt;记忆出口另受 10% 比例和启动期&lt;br&gt;64 KiB 引导额度限制。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#E7F4EE;strokeColor=#76AD96;fontColor=#285945;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="25" y="561" width="292" height="118" as="geometry"/></mxCell><mxCell id="p" value="&lt;font style=&quot;font-size:18px;color:#285945&quot;&gt;&lt;b&gt;个人经验&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;个人世界按“自身认识”读取，保留&lt;br&gt;来源。只选个人经验时，普通回忆&lt;br&gt;不会把它当作事件返回。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#E7F4EE;strokeColor=#76AD96;fontColor=#285945;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="355" y="561" width="292" height="118" as="geometry"/></mxCell><mxCell id="pe" value="&lt;font style=&quot;font-size:18px;color:#285945&quot;&gt;&lt;b&gt;人物相处经验&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;引用材料能归到同一交往对象，&lt;br&gt;且当前人物身份已确认时才提供。&lt;br&gt;与已有相处经验共享装配字数预算。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#E7F4EE;strokeColor=#76AD96;fontColor=#285945;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="683" y="561" width="292" height="118" as="geometry"/></mxCell><mxCell id="aside" value="&lt;font style=&quot;font-size:18px;color:#784A31&quot;&gt;&lt;b&gt;另外两个出口来自一般自省六问&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#304755&quot;&gt;工具需求及后续交流记为待处理建议，保存在主体历史的 introspection_candidate 中。它们可以单独成立，&lt;br&gt;也可以与记忆或经验并存。建议本身不会执行工具或发送消息。&lt;/font&gt;" style="rounded=1;arcSize=11;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.5;fillColor=#FBEDE4;strokeColor=#D1A688;fontColor=#784A31;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1"><mxGeometry x="25" y="747" width="950" height="87" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r" target="s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r" target="k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.28;exitY=1;entryX=0.73;entryY=0;" edge="1" parent="1" source="s" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="k" target="formal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.08;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="formal" target="m"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.38;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="formal" target="p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#647984;strokeWidth=1.6;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#4C6470;exitX=0.76;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="formal" target="pe"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
