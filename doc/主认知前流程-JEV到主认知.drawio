<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="主认知之前 · ② JEV 到主认知的关系" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="800" height="40" as="geometry"/></mxCell><mxCell id="in" value="入口材料就绪&lt;br&gt;原话＋证据＋现场" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="65" as="geometry"/></mxCell><mxCell id="entry" value="JEV 入口判断&lt;br&gt;人物 / 交往 / 控制" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="150" height="65" as="geometry"/></mxCell><mxCell id="bg" value="背景&lt;br&gt;留作现场，不回应" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="150" height="65" as="geometry"/></mxCell><mxCell id="wait" value="表达未完&lt;br&gt;保留原话，等接续" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="220" y="230" width="150" height="65" as="geometry"/></mxCell><mxCell id="prep" value="JEV 回应准备&lt;br&gt;档位 / 召回 / 短答" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="150" height="65" as="geometry"/></mxCell><mxCell id="control" value="停说或改向&lt;br&gt;取消 / 替换旧未播内容" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="150" height="65" as="geometry"/></mxCell><mxCell id="retry" value="失效或调用失败&lt;br&gt;有限重判 / 记录未判断" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="610" y="230" width="150" height="65" as="geometry"/></mxCell><mxCell id="short" value="允许直接短答&lt;br&gt;跳过主认知" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="610" y="370" width="150" height="65" as="geometry"/></mxCell><mxCell id="turn" value="主流程待处理队列&lt;br&gt;关联原话与交付上下文" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="370" width="150" height="65" as="geometry"/></mxCell><mxCell id="draft" value="前段准备（可选）&lt;br&gt;校验复用 / 放弃草稿" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="490" width="150" height="65" as="geometry"/></mxCell><mxCell id="mainprep" value="主认知前组装&lt;br&gt;落位 / 人物 / 工具 / 召回" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="150" height="65" as="geometry"/></mxCell><mxCell id="model" value="主认知模型调用&lt;br&gt;本图终点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="610" y="610" width="150" height="65" as="geometry"/></mxCell><mxCell id="context" value="只读 / 后台更新&lt;br&gt;片场、档案、播放回执" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="150" height="65" as="geometry"/></mxCell><mxCell id="parallel" value="新话关系判断（可选）&lt;br&gt;并行判断接续或换题" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="220" y="370" width="150" height="65" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="in" target="entry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="background" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="entry" target="bg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="wait" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="entry" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="prepare" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="entry" target="prep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="stop/redirect" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="entry" target="control"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="异常" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="entry" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="仅允许的失效重判" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="retry" target="entry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="短答许可" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="prep" target="short"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="main" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="prep" target="turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="turn" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="draft" target="mainprep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="mainprep" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="现场证据" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="context" target="in"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="读取" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="context" target="mainprep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="许可" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="parallel" target="turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="新请求另判" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="control" target="turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="主路径以 split 模式为例；combined 将入口与回应准备合为一次调用，decision 使用原生决策并可回退。&lt;br&gt;背景 / 等待 / 短答不进入主认知；同一原话的保留、替换、取消记录会进入上下文。" style="text;html=1;fontSize=14;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="25" y="755" width="790" height="55" as="geometry"/></mxCell></root></mxGraphModel>
