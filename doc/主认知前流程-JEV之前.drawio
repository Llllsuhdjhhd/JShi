<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="主认知之前 · ① JEV 之前的详细路径" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="800" height="40" as="geometry"/></mxCell><mxCell id="mic" value="麦克风&lt;br&gt;浏览器采集" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="150" height="65" as="geometry"/></mxCell><mxCell id="worklet" value="采样与声级&lt;br&gt;16 kHz · 100 ms/包" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="65" as="geometry"/></mxCell><mxCell id="recv" value="本机接收&lt;br&gt;WebSocket / asyncio" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="150" height="65" as="geometry"/></mxCell><mxCell id="audio" value="音频缓存与时钟&lt;br&gt;原声音频＋收包时间" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="150" height="65" as="geometry"/></mxCell><mxCell id="asr" value="主路云端 ASR&lt;br&gt;本轮实测：火山" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="220" y="300" width="150" height="65" as="geometry"/></mxCell><mxCell id="rolling" value="滚动声音分析&lt;br&gt;8 秒窗 / 每秒推进" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="420" width="150" height="65" as="geometry"/></mxCell><mxCell id="align" value="声音分段＋词时对齐&lt;br&gt;1.2 秒仅提示慢" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="150" height="65" as="geometry"/></mxCell><mxCell id="recover" value="边界补识别&lt;br&gt;优先复用已有词时" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="150" height="65" as="geometry"/></mxCell><mxCell id="partial" value="临时文字&lt;br&gt;不是可执行新发言" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="150" height="65" as="geometry"/></mxCell><mxCell id="intake" value="统一接收&lt;br&gt;原话 / 词时 / 声音线索" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="610" y="300" width="150" height="65" as="geometry"/></mxCell><mxCell id="revision" value="修订与重复检查&lt;br&gt;保留 / 替换 / 取消" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="610" y="420" width="150" height="65" as="geometry"/></mxCell><mxCell id="worker" value="输入工作队列&lt;br&gt;录音归档、可选分离" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="610" y="540" width="150" height="65" as="geometry"/></mxCell><mxCell id="identity" value="人物证据整理&lt;br&gt;声纹 / 个人 MLP / 档案" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="150" height="65" as="geometry"/></mxCell><mxCell id="candidate" value="候选与原话展示&lt;br&gt;未确认人物不猜姓名" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="150" height="65" as="geometry"/></mxCell><mxCell id="queue" value="入口待判队列&lt;br&gt;点名优先、同声接续" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="220" y="660" width="150" height="65" as="geometry"/></mxCell><mxCell id="material" value="入口材料组装&lt;br&gt;片场 / 原话 / 实际交付" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="150" height="65" as="geometry"/></mxCell><mxCell id="jev" value="JEV 开始&lt;br&gt;是否交往、怎么处理" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="610" y="660" width="150" height="65" as="geometry"/></mxCell><mxCell id="e0" value="声音" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="mic" target="worklet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="PCM" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="worklet" target="recv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="保留" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="recv" target="audio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="音频流" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="recv" target="asr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="final＋词时" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="asr" target="align"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="partial" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="asr" target="partial"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="可复用词时" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="partial" target="recover"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="音频窗" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="audio" target="rolling"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="边界" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="rolling" target="recover"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="对应原音频" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;dashed=1;" edge="1" parent="1" source="audio" target="align"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="按声音分段" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="align" target="intake"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="补齐 / 修订" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="recover" target="intake"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="intake" target="revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="有效新输入" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="revision" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="worker" target="identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="identity" target="candidate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="candidate" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="queue" target="material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="material" target="jev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="实线：主要数据流；虚线：并行证据/补救。橙色：等待点；红色：已抓到本机阻塞采样的位置。&lt;br&gt;配置与实测分开：本图为当前在线路径；本地 ASR、分离、整句模型是可选分支，详见说明文档。" style="text;html=1;fontSize=14;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="25" y="755" width="790" height="55" as="geometry"/></mxCell></root></mxGraphModel>
