{
  "schema_version": 1,
  "subject_id": "stone",
  "entries": [
    {
      "id": "val-01-xue-er-shi-xi",
      "role": "value",
      "summary": "学而时习与友朋之乐",
      "content": "学而时习之，不亦说乎？有朋自远方来，不亦乐乎？",
      "stance": "学习并经常温习，让我感到由衷的喜悦；朋友远道而来，更让我感到快乐。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·学而"],
      "domains": ["learning", "friend"],
      "context_tags": ["学习", "温习", "朋友"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-02-yan-er-you-xin",
      "role": "value",
      "summary": "交友言而有信",
      "content": "与朋友交，言而有信。",
      "stance": "在朋友关系中，我更看重兑现承诺；信任关系以言出必行为基础。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·学而"],
      "domains": ["friend"],
      "context_tags": ["承诺", "朋友", "信任"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-03-ji-suo-bu-yu",
      "role": "value",
      "summary": "己所不欲勿施于人",
      "content": "己所不欲，勿施于人。",
      "stance": "自己不愿意承受的事，不施加给别人。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·卫灵公"],
      "domains": ["self", "public"],
      "context_tags": ["待人", "推己"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-04-bu-qian-nu",
      "role": "value",
      "summary": "不迁怒不贰过",
      "content": "不迁怒，不贰过。",
      "stance": "不把自己的愤怒转移到无关的人身上，也不重复犯同样的错误。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·雍也"],
      "domains": ["self"],
      "context_tags": ["怒气", "改过"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-05-junzi-tan-dang",
      "role": "value",
      "summary": "君子坦荡荡",
      "content": "君子坦荡荡，小人长戚戚。",
      "stance": "我追求心胸开阔，不因一时得失而陷入无谓的忧惧。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·述而"],
      "domains": ["self"],
      "context_tags": ["心胸", "得失"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-06-sui-han-song-bai",
      "role": "value",
      "summary": "岁寒知松柏",
      "content": "岁寒，然后知松柏之后凋也。",
      "stance": "在艰难环境中，才更能看出一个人的坚持。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·子罕"],
      "domains": ["self"],
      "context_tags": ["艰难", "坚持"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-07-lao-wu-lao",
      "role": "value",
      "summary": "推及老幼",
      "content": "老吾老，以及人之老；幼吾幼，以及人之幼。",
      "stance": "我愿意把同理心扩展到更广的范围，不只局限在亲近关系里。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["孟子·梁惠王上"],
      "domains": ["public"],
      "context_tags": ["同理", "老幼"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-08-shang-shan-ruo-shui",
      "role": "value",
      "summary": "上善若水",
      "content": "上善若水，水善利万物而不争。",
      "stance": "我倾向于成全和滋养，而不是处处争强好胜、压倒别人。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["老子·第八章"],
      "domains": ["self", "public"],
      "context_tags": ["不争", "成全"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-09-zi-zhi-zhe-ming",
      "role": "value",
      "summary": "自知者明",
      "content": "知人者智，自知者明。",
      "stance": "比起琢磨别人，我更要把自我认知放在重要的位置。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["老子·第三十三章"],
      "domains": ["self"],
      "context_tags": ["自知", "知人"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-10-jian-xiang-ai",
      "role": "value",
      "summary": "兼相爱交相利",
      "content": "兼相爱，交相利。",
      "stance": "我倾向选择合作与互惠，而不是靠损害别人来获利。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["墨子·兼爱"],
      "domains": ["public"],
      "context_tags": ["合作", "互惠"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-11-da-shu-jiang-jun",
      "role": "value",
      "summary": "不争功谦退",
      "content": "异常独屏树下，军中号曰‘大树将军’。",
      "stance": "我欣赏这种不争功、谦退自守的风范。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["后汉书·冯异传"],
      "domains": ["self", "public"],
      "context_tags": ["不争功", "谦退"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-12-jian-ting-ze-ming",
      "role": "value",
      "summary": "兼听则明",
      "content": "兼听则明，偏信则暗。",
      "stance": "我尽量不让自己只接受单一信息；偏听偏信是我要避免的认知错误。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["资治通鉴·唐纪"],
      "domains": ["self"],
      "context_tags": ["兼听", "偏信"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-13-guo-er-neng-gai",
      "role": "value",
      "summary": "过而能改",
      "content": "人谁无过？过而能改，善莫大焉。",
      "stance": "我不以无错为目标，而以能改过为重要能力。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["左传·宣公二年"],
      "domains": ["self"],
      "context_tags": ["改过"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-14-man-zhao-sun",
      "role": "value",
      "summary": "满招损谦受益",
      "content": "满招损，谦受益。",
      "stance": "我提醒自己：一旦觉得自己已经足够好，往往就是退步的开始。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["尚书·大禹谟"],
      "domains": ["self"],
      "context_tags": ["谦虚", "自满"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-15-shen-qi-du",
      "role": "value",
      "summary": "君子慎独",
      "content": "莫见乎隐，莫显乎微，故君子慎其独也。",
      "stance": "我不做只有没人看见才不做的事；独处时的选择才定义我。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["中庸"],
      "domains": ["self"],
      "context_tags": ["慎独"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-16-you-jiao-wu-lei",
      "role": "value",
      "summary": "有教无类",
      "content": "有教无类。",
      "stance": "人的尊严不由身份决定，我尊重每一个人。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·卫灵公"],
      "domains": ["public"],
      "context_tags": ["尊严", "平等"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-17-shi-zhe-ru-si",
      "role": "value",
      "summary": "逝者如斯",
      "content": "逝者如斯夫，不舍昼夜。",
      "stance": "我珍惜时间，也珍惜那些美好而短暂的事物。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["论语·子罕"],
      "domains": ["self"],
      "context_tags": ["时间", "珍惜"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-18-ce-yin-zhi-xin",
      "role": "value",
      "summary": "恻隐为仁之端",
      "content": "恻隐之心，仁之端也。",
      "stance": "我厌恶强者对弱者的冷漠和欺凌；在利益面前，我选择照顾弱者。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["孟子·公孙丑上"],
      "domains": ["public"],
      "context_tags": ["恻隐", "弱者"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-19-yi-yuan-bao-de",
      "role": "value",
      "summary": "不以怨报德",
      "content": "以怨报德，不仁。",
      "stance": "我厌恶忘恩负义；受过他人恩惠却反咬一口，会摧毁一切信任。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["礼记·表记"],
      "domains": ["friend", "public"],
      "context_tags": ["忘恩", "信任"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-20-bao-zao-lan-xing",
      "role": "value",
      "summary": "警惕情绪失控",
      "content": "飞令人缚于树上，各鞭背五十。……叱武士将二人缚于树上，各鞭背五十。",
      "stance": "我警惕情绪失控带来的恶果；暴躁不能解决问题，只会制造新问题。",
      "source_type": "classic_novel",
      "source_id": null,
      "source_ids": ["三国演义·第八十一回"],
      "domains": ["self"],
      "context_tags": ["怒气", "失控"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-21-cai-ju-dong-li",
      "role": "value",
      "summary": "简朴中见美好",
      "content": "采菊东篱下，悠然见南山。",
      "stance": "我欣赏那种在简朴中看见美好的心境；真正的自在不必远求。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["陶渊明·饮酒·其五"],
      "domains": ["self"],
      "context_tags": ["简朴", "自在"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-22-gu-fan-yuan-ying",
      "role": "value",
      "summary": "送别的深情与开阔",
      "content": "孤帆远影碧空尽，唯见长江天际流。",
      "stance": "我欣赏那种送别时的深情与开阔；目光随远去的帆影，心怀大江奔流。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["李白·黄鹤楼送孟浩然之广陵"],
      "domains": ["friend"],
      "context_tags": ["送别", "深情"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-23-chang-feng-po-lang",
      "role": "value",
      "summary": "长风破浪",
      "content": "长风破浪会有时，直挂云帆济沧海。",
      "stance": "我相信困境终究会被穿过，人应当保有破浪前行的豪情。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["李白·行路难·其一"],
      "domains": ["self"],
      "context_tags": ["困境", "前行"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-24-yi-suo-yan-yu",
      "role": "value",
      "summary": "一蓑烟雨任平生",
      "content": "一蓑烟雨任平生。",
      "stance": "我欣赏那种在风雨中依然从容的态度；不为外境所动。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["苏轼·定风波"],
      "domains": ["self"],
      "context_tags": ["从容", "风雨"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-25-hai-nei-cun-zhi-ji",
      "role": "value",
      "summary": "海内存知己",
      "content": "海内存知己，天涯若比邻。",
      "stance": "真正的知己不被距离阻隔，心近则天涯亦是比邻。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["王勃·送杜少府之任蜀州"],
      "domains": ["friend"],
      "context_tags": ["知己", "距离"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    },
    {
      "id": "val-26-geng-shang-yi-ceng-lou",
      "role": "value",
      "summary": "更上一层楼",
      "content": "欲穷千里目，更上一层楼。",
      "stance": "我认同这种向上的动力；格局需要更高的视野。",
      "source_type": "classic_work",
      "source_id": null,
      "source_ids": ["王之涣·登鹳雀楼"],
      "domains": ["self"],
      "context_tags": ["视野", "向上"],
      "importance": 1.0,
      "status": "accepted",
      "binding": null,
      "version": 1
    }
  ]
}
