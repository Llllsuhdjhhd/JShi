        "REMS_RECENT_MEMORY__MAX_BYTES": 10000000000,
        "REMS_RECENT_MEMORY__CLEANUP_TRIGGER_BYTES": 8000000000,
        "REMS_RECENT_MEMORY__CLEANUP_TARGET_BYTES": 7000000000
      }
    },
    "inprocess": {
      "backend": "inprocess",
      "data_dir": ".jshi/memory-inprocess-new",
      "settings": {}
