# Copy these fields into the existing .env. Keep your conversation model settings.
# Local CPU ASR + speaker embeddings + preset TTS. Online interfaces remain available.
JSHI_VOICE_ASR=local
JSHI_VOICE_TTS=local
JSHI_VOICE_API_KEY=
# Optional Deepgram ASR; TTS remains separately selected above.
# JSHI_VOICE_ASR=deepgram
JSHI_DEEPGRAM_API_KEY=
JSHI_DEEPGRAM_MODEL=nova-3
JSHI_DEEPGRAM_LANGUAGE=zh-CN
JSHI_DEEPGRAM_DIARIZE=true
# WSL Qwen3-ASR: Windows Silero VAD + speaker analysis; no cloud ASR key required.
# JSHI_VOICE_ASR=qwen
JSHI_QWEN_ASR_URL=http://127.0.0.1:8000/v1
# Requires tools/start_qwen_batch_wsl.sh (native batch service).
# Empty: discover the single model returned by /v1/models.
JSHI_QWEN_ASR_MODEL=
JSHI_QWEN_ASR_TIMEOUT_S=60
JSHI_QWEN_ASR_BATCH_SIZE=8
# Prepare CPU frontend once: jshi voice-setup --vad --diarize
JSHI_VOICE_LOCAL_THREADS=2
# Select cam++ or eres2netv2. Model banks remain separate.
JSHI_VOICE_SPEAKER_MODEL=cam++
JSHI_VOICE_REFINE=auto
JSHI_VOICE_MATCH_THRESHOLD=0.65
JSHI_VOICE_ENROLL_THRESHOLD=0.8

# Simple, stable JShi voice. Replace speaker with an authorized preset from the console.
# These speaker/direction fields apply to online TTS. Local uses one fixed preset;
# JSHI_VOICE_RATE controls speed for both backends.
JSHI_VOICE_TTS_RESOURCE=seed-tts-2.0
JSHI_VOICE_TTS_TRANSPORT=websocket
JSHI_VOICE_SPEAKER=zh_female_vv_uranus_bigtts
JSHI_VOICE_RATE=-5
JSHI_VOICE_DIRECTION=自然、平静地交谈，吐字清楚，语气亲切，不要播音腔。

# Recommended trial: online ASR + local TTS. Add API Key above, then restart.
# The webpage can choose online/local ASR per conversation when both are loaded.
# Online ASR uploads the session audio. Local voiceprint matching uses RAM only.
# JSHI_VOICE_TTS=online
# JSHI_VOICE_ASR=online
# JSHI_VOICE_ASR_RESOURCE=volc.seedasr.sauc.duration
# Speech endpoint silence, milliseconds. Qwen fixed strategy: 500ms / max 3.5s.
# smart_turn runs alongside ASR; eager bypasses only the audio turn model.
JSHI_VOICE_END_WINDOW_MS=500
JSHI_VOICE_SEGMENT_STRATEGY=fixed
JSHI_VOICE_MAX_WINDOW_MS=3500
JSHI_VOICE_TURN_STRATEGY=smart_turn
JSHI_VOICE_TURN_THRESHOLD=0.5
JSHI_VOICE_TURN_TIMEOUT_MS=600
JSHI_VOICE_TURN_MAX_HOLD_MS=2000
# Independent text semantics: namo enables the local model; off skips it entirely.
JSHI_VOICE_SEMANTIC_TURN=namo
JSHI_VOICE_SEMANTIC_THRESHOLD=0.5
JSHI_VOICE_SEMANTIC_TIMEOUT_MS=200
# Sent to Volc ASR on every connection. Comma-separated; empty disables hotwords.
JSHI_VOICE_ASR_HOTWORDS=陆广,陆兴,秦奋,广,广广,JEV,匠石,匠匠,声纹,未来城,匠
# Final ASR text dispatches immediately; no extra text collection timer.
# Legacy INPUT_PAUSE_MS / INPUT_MAX_BATCH_MS / INPUT_BATCH_CHARS are
# accepted for compatibility but no longer control dispatch.
# Maximum wait for additional voiceprint candidates; existing ASR evidence is reused.
JSHI_VOICE_CANDIDATE_TIMEOUT_MS=1200
# Optional audio-source extraction. Off until model access and dependencies are ready.
# Install the voice-separation extra and accept both pyannote AMI model conditions.
# HF_TOKEN stays local. Single-speaker audio uses the same path without separation.
JSHI_VOICE_SEPARATION=off
# JSHI_VOICE_SEPARATION_DEVICE=cuda
# JSHI_VOICE_SEPARATION_TIMEOUT_S=30
# JSHI_VOICE_IDENTITY_MODE=diarization
# Single-speaker matching mode (not simultaneous multi-speaker separation):
# JSHI_VOICE_IDENTITY_MODE=voiceprint
# JSHI_VOICEPRINT_GROUP=

# JEV uses the existing conversation model by default; these can override it.
# JSHI_SKILL_VOICE_JEV_VENDOR=
# JSHI_SKILL_VOICE_JEV_MODEL=
# JSHI_SKILL_VOICE_JEV_THINKING=disabled

# A longer silent gap resets recent JEV dialogue context (seconds), not scenes.
# Continuous exchanges retain their earlier context; stored history is not deleted.
JSHI_JEV_CONTEXT_IDLE_SECONDS=300

# Separate JEV scene-history cache; summaries expire by age or summary-character budget.
# JEV2 may also explicitly discard provided history entries after a successful commit.
JSHI_JEV_HISTORY_MAX_AGE_SECONDS=300
JSHI_JEV_HISTORY_MAX_CHARS=500

# Optional brief acknowledgement while cognition runs; no extra LLM call.
JSHI_JEV_WAIT_ACK_ENABLED=false
