# 复制成 .env 再填值。.env 已被 .gitignore 忽略，不会进仓库。
#
# 模型（真实对话才需要；测试用假模型端口，不需要任何环境变量）
JSHI_MODEL_ENDPOINT=
JSHI_MODEL_API_KEY=
JSHI_MODEL_NAME=
# 按厂商分别配 key 时用这个形式（例：JSHI_API_DEEPSEEK_API_KEY）
# JSHI_API_DEEPSEEK_API_KEY=
# 思考档位（可选）：disabled / low / high ...
JSHI_MODEL_THINKING=

# 数据落点（默认 ./.jshi）
JSHI_DATA_DIR=
# 技能配置（默认 ./skills.json）
JSHI_SKILLS_FILE=
# 指定另一份 env 文件（可选）
JSHI_ENV_FILE=

# 记忆后端：inprocess（默认）或 rems
JSHI_MEMORY_BACKEND=
JSHI_REMS_DATA_DIR=
JSHI_REMS_SKIP_EMBEDDING=
REMS_CONTEXT_WINDOW=
REMS_CHARS_PER_TOKEN=
# 离线跑 HuggingFace 模型时置 1
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# 工具引擎：pi（默认）或 stub
JSHI_TOOL_ENGINE=
JSHI_PI_EXECUTABLE=
JSHI_PI_PROVIDER=
JSHI_PI_HOME=
# 工具反馈包装的并发上限（默认 2）
JSHI_TOOL_WRAP_CONCURRENCY=

# 闲时（可选）
JSHI_IDLE_SECONDS=
JSHI_IDLE_MAX_ROUNDS=
