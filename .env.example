# 复制成 .env 再填值。.env 已被 .gitignore 忽略，不会进仓库。
# 下列已填的是程序缺省；改值才会覆盖。空着的项没有默认，真实对话才需要。

# 模型（真实对话才需要；测试用假模型端口，不需要任何环境变量）
JSHI_MODEL_ENDPOINT=
JSHI_MODEL_API_KEY=
JSHI_MODEL_NAME=
# 按厂商分别配 key 时用这个形式（例：JSHI_API_DEEPSEEK_API_KEY）
# JSHI_API_DEEPSEEK_API_KEY=
# 思考档位：disabled / low / enabled / medium / high / max / xhigh（缺省 disabled）
JSHI_MODEL_THINKING=disabled

# 数据落点
JSHI_DATA_DIR=.jshi
# 技能配置（缺省找仓库根 / 当前目录的 skills.json）
JSHI_SKILLS_FILE=./skills.json
# 指定另一份 env 文件（可选；缺省自动读仓库根 / 当前目录的 .env）
# JSHI_ENV_FILE=

# 记忆后端：inprocess 或 rems3
JSHI_MEMORY_BACKEND=inprocess
# rems 数据目录（缺省 {JSHI_DATA_DIR}/rems）
JSHI_REMS_DATA_DIR=.jshi/rems
# 跳过嵌入：1 / true / yes（缺省不跳过）
JSHI_REMS_SKIP_EMBEDDING=
# rememory 缺省（见邻仓 RemsConfig）；对齐匠石 1M 窗口时可改 1000000
REMS_CONTEXT_WINDOW=1000000
REMS_CHARS_PER_TOKEN=1.5
# 离线跑 HuggingFace 模型时置 1（缺省不离线）
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# 工具引擎：pi 或 stub
JSHI_TOOL_ENGINE=pi
# Windows 缺省 pi.cmd，其它平台 pi
JSHI_PI_EXECUTABLE=pi.cmd
JSHI_PI_PROVIDER=deepseek
# Pi 主目录（缺省空，用 Pi 自己的默认）
JSHI_PI_HOME=
# 工具反馈包装的并发上限
JSHI_TOOL_WRAP_CONCURRENCY=2

# 闲时
JSHI_IDLE_SECONDS=180
JSHI_IDLE_MAX_ROUNDS=2
